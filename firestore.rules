rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // YARDIMCI GÜVENLİK VE YETKİLENDİRME FONKSİYONLARI
    // ========================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().get('role', '') == 'admin') ||
        request.auth.token.get('admin', false) == true
      );
    }

    // Ban kontrolü: users koleksiyonundaki isBanned alanı true olmamalıdır
    function isNotBanned() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().get('isBanned', false) != true
      );
    }

    // ========================================================
    // 1. KULLANICI PROFİLLERİ (users/{userId})
    // ========================================================
    match /users/{userId} {
      // Topluluk profillerini herkes okuyabilir
      allow read: if true;

      // Kullanıcı oluşturma ve güncelleme (Admin panelinden engelleme / ban güncellemesi dahil)
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || true;
    }

    // Moderasyon ve Yönetici Ayarları
    match /moderation/{docId} {
      allow read, write: if true;
    }

    // ========================================================
    // 2. FORUM GÖNDERİLERİ (forum_posts/{postId})
    // ========================================================
    match /forum_posts/{postId} {
      // OKUMA, OLUŞTURMA, GÜNCELLEME VE SİLME KURALLARI:
      // Admin paneli oturumu ve topluluk etkileşimleri için tam senkronizasyon izni
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // ========================================================
    // 3. GÜVENLİK VE BOT BİLDİRİMLERİ (moderation_alerts/{alertId})
    // ========================================================
    match /moderation_alerts/{alertId} {
      allow read, create, update, delete: if true;
    }

    // ========================================================
    // 4. İLETİŞİM & RANDEVU FORMLARI (contact_messages/{messageId})
    // ========================================================
    match /contact_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // ========================================================
    // 5. YASAKLI KULLANICILAR VE UYARILAR
    // ========================================================
    match /banned_users/{userId} {
      allow read, write: if true;
    }

    match /user_warnings/{warningId} {
      allow read, write: if true;
    }

    // ========================================================
    // 6. ADMİN GÜVENLİK YAPILANDIRMASI (adminConfig/{docId})
    // ========================================================
    match /adminConfig/{docId} {
      allow read, write: if true;
    }

    // ========================================================
    // 7. KARAKTER VE DİZİ ANALİZİ ETKİLEŞİMLERİ (Beğeniler ve Yorumlar)
    // ========================================================
    match /analysis_comments/{commentId} {
      allow read, create, update, delete: if true;
    }

    match /analysis_likes/{likeId} {
      allow read, create, update, delete: if true;
    }
  }
}
